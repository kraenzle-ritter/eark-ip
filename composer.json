{
  "name": "kraenzle-ritter/eark-ip",
  "description": "Read, validate and write E-ARK information packages (CSIP, SIP, AIP, DIP) in plain PHP.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "e-ark",
    "csip",
    "sip",
    "aip",
    "dip",
    "mets",
    "premis",
    "oais",
    "information-package",
    "archives",
    "digital-preservation"
  ],
  "homepage": "https://github.com/kraenzle-ritter/eark-ip",
  "support": {
    "issues": "https://github.com/kraenzle-ritter/eark-ip/issues",
    "source": "https://github.com/kraenzle-ritter/eark-ip"
  },
  "authors": [
    {
      "name": "Kraenzle & Ritter",
      "email": "info@k-r.ch"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "phpstan/phpstan": "^2.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "KraenzleRitter\\EarkIp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KraenzleRitter\\EarkIp\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/eark-ip"
  ],
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": "pint",
    "corpus": "sh tools/fetch-corpus.sh"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
