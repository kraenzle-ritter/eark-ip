#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new KraenzleRitter\EarkIp\Cli\Application)->run(array_slice($argv, 1)));
